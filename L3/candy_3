#include <stdio.h>

    int adder(int n1, int n2){
        printf("Adder was called: ");
        return n1+n2;
    }

    int divider(int n1, int n2){
        printf("Divider was called: ");
        return n1/n2; 
    }

    void printResult(int n1, int n2, int(*fPtr)(int,int)){ // declare a function pointer that takes two int parameters and returns an int
        printf("%d \n",fPtr(n1,n2));
    }

    void main(){
        int num1 =10;
        int num2 =5;
        printResult(num1,num2,adder);       //passing the function pointer as an argument to the printResult function
        printResult(num1,num2,divider);
        printf("\n");
    }
    